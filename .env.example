# Database (SQLite for local/demo, PostgreSQL for production)
# Production example: postgresql://user:pass@host:5432/bidhapith?schema=public
DATABASE_URL="file:./data/bidhapith.db"
DIRECT_URL="file:./data/bidhapith.db"

# Auth
AUTH_SECRET="change-this-to-a-long-random-string-in-production"
NEXTAUTH_URL="http://localhost:3000"
DEMO_MODE="true"

# Platform
BASE_DOMAIN="localhost:3000"
PLATFORM_NAME="বিধাপীঠ"
SUPPORT_EMAIL="support@bidhapith.com"
SUPPORT_PHONE="01700000000"
CURRENCY="BDT"
TIMEZONE="Asia/Dhaka"
DEFAULT_LANGUAGE="bn"

# Payments — never commit real credentials
PAYMENT_PROVIDER="demo"
BKASH_API_KEY=""
BKASH_SECRET=""
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_SANDBOX="true"
NAGAD_API_KEY=""
NAGAD_MERCHANT_ID=""
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_SANDBOX="true"

# SMS
SMS_PROVIDER="demo"
SMS_PROVIDER_URL=""
SMS_API_KEY=""
SMS_SENDER_ID="BIDHAPITH"
SMS_USERNAME=""
SMS_PASSWORD=""
SMS_RATE="0.35"

# Email / SMTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@bidhapith.com"

# Object storage
STORAGE_ENDPOINT=""
STORAGE_BUCKET="bidhapith"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION="auto"

# Domains / SSL
DNS_CNAME_TARGET="schools.bidhapith.com"
